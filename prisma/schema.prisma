generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id         String          @id @default(cuid())
  name       String
  type       String
  createdAt  DateTime        @default(now())
  profiles   Profile[]
  campaigns  Campaign[]
  templates  GroupTemplate[]
}

model Profile {
  id           String            @id @default(cuid())
  name         String
  fbUsername   String
  edgeProfile  String            @default("Default")
  business     Business          @relation(fields: [businessId], references: [id])
  businessId   String
  isActive      Boolean           @default(true)
  dailyLimit    Int               @default(150)
  postsToday    Int               @default(0)
  lastReset     DateTime          @default(now())
  nextPostAt    DateTime?         // הפוסט הבא מותר רק מהזמן הזה - פיזור לאורך היום (3-6 דק' בין פוסטים)
  whatsappPhone String?
  userId        String?
  campaigns     CampaignProfile[]
}

model GroupTemplate {
  id         String    @id @default(cuid())
  name       String
  business   Business  @relation(fields: [businessId], references: [id])
  businessId String
  userId     String?
  groups     Group[]
}

model Group {
  id              String        @id @default(cuid())
  fbGroupId       String
  name            String
  memberCount     Int?
  lastSeenAt      DateTime?
  dedupSkipReason String?
  template        GroupTemplate @relation(fields: [templateId], references: [id])
  templateId      String

  @@unique([fbGroupId, templateId])
}

model Campaign {
  id           String            @id @default(cuid())
  title        String
  content      String
  whatsappLink    String?
  whatsappMessage String?
  emailLink       String?
  imageUrls    String[]
  status       String            @default("draft")
  business     Business          @relation(fields: [businessId], references: [id])
  businessId   String
  templateIds      String
  groupIds         String    @default("[]")
  backgroundIndex  Int?
  scheduledAt      DateTime?
  recurring        Boolean           @default(false)
  userId           String?
  externalId       String?           @unique // מזהה מהמערכת החיצונית (שירה AI) - מונע קמפיין כפול בשליחה חוזרת
  createdAt    DateTime          @default(now())
  posts        Post[]
  profiles     CampaignProfile[]
}

model CampaignProfile {
  id         String   @id @default(cuid())
  campaign   Campaign @relation(fields: [campaignId], references: [id])
  campaignId String
  profile    Profile  @relation(fields: [profileId], references: [id])
  profileId  String
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  password          String
  role              String    @default("user")
  businessId        String?
  apiToken          String?   @unique
  apiTokenDeviceId  String?   // נקשר אוטומטית למכשיר הראשון שמשתמש בטוקן (TOFU) - ריק = עדיין לא נתפס
  apiTokenExpiresAt DateTime? // תוקף קבוע מרגע ההנפקה/החידוש - טוקן שהעתיקו למכונה אחרת לא יעבוד לנצח
  createdAt         DateTime  @default(now())
}

// מפתחות API למערכות חיצוניות (שירה AI). נשמר רק hash (sha256) - המפתח עצמו
// מוצג פעם אחת ביצירה. כל מפתח קשור למשתמש אחד, וכל מה שנוצר איתו שייך לו.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  userId     String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
}

model ContactLink {
  id         String   @id @default(cuid())
  label      String
  type       String   // "whatsapp" | "email"
  value      String
  businessId String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SyncJob {
  id          String   @id @default(cuid())
  userId      String
  businessId  String
  type        String   @default("sync")
  status      String   @default("pending")
  groupCount  Int?
  groupsFound Int      @default(0)
  claimedBy   String?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Post {
  id          String    @id @default(cuid())
  campaign    Campaign  @relation(fields: [campaignId], references: [id])
  campaignId  String
  fbGroupId   String
  groupName   String
  status      String    @default("pending")
  claimedBy   String?
  claimedAt   DateTime? // מתי status עבר ל-"running" - נדרש כדי לזהות עבודות תקועות (createdAt לא מספיק, הוא נקבע ביצירת הפוסט, לא בתפיסה)
  publishedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  // לפי מזהה ולא לפי שם: הרבה קבוצות דרושים שונות נקראות באותו שם, וייחודיות
  // לפי groupName בלעה בשקט את כולן חוץ מאחת באותו קמפיין
  @@unique([campaignId, fbGroupId])
}
